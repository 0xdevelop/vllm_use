# Non-secret service configuration. Keep this file mode 0600 because operators
# may add VLLM_USE_ADMIN_TOKEN or VLLM_USE_UPSTREAM_API_KEY locally.
VLLM_USE_LISTEN=127.0.0.1:8080
VLLM_USE_DATA_DIR=/var/lib/vllm-use
VLLM_USE_HF_HOME=/var/cache/vllm-use/huggingface
VLLM_USE_VLLM_BINARY=vllm
VLLM_USE_HF_CLI=hf
VLLM_USE_UPSTREAM=http://127.0.0.1:8000
# Retain the newest inference audit events; set to 0 to disable new audit writes.
VLLM_USE_MAX_AUDIT_RECORDS=10000

# Prefer a systemd credential or a root-readable EnvironmentFile for secrets.
# If VLLM_USE_ADMIN_TOKEN is omitted, first startup creates the one-time
# bootstrap token at /var/lib/vllm-use/admin-bootstrap.token.
# VLLM_USE_ADMIN_TOKEN=
# VLLM_USE_UPSTREAM_API_KEY=
